# Copy to .env for `npm run dev`.
DATABASE_URL=postgres://app:app@localhost/sporty_dev
SESSION_SECRET=change-me

# Set to true when connecting to a database that requires TLS (e.g. Render's external URL).
# DATABASE_SSL=true

# Optional email. With it set, students log in with a 6-digit code sent to their inbox,
# sign-ups must verify their IITR email, password reset works, and players get an email
# when their match fills up. Brevo works on Render's free plan (it blocks SMTP ports).
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM="IITR Sporty Match <hello@yourdomain.in>"
# Or, where SMTP is allowed:
# SMTP_URL=smtps://user:app-password@smtp.gmail.com:465

# Optional overrides.
# ALLOWED_EMAIL_DOMAIN=iitr.ac.in
# APP_URL=https://your-custom-domain.example
