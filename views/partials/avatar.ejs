<%# A user's photo, or their initials when they haven't added one. Needs `u` with id, name, avatar_token. %>
<% const avatarClass = ['avatar', locals.size && `avatar-${size}`, locals.extraClass].filter(Boolean).join(' '); %>
<% if (u.avatar_token) { %><img class="<%= avatarClass %>" src="/avatars/<%= u.id %>?v=<%= u.avatar_token %>" alt="" loading="lazy" decoding="async"><% } else { %><span class="<%= avatarClass %>" aria-hidden="true"><%= initials(u.name) %></span><% } %>
