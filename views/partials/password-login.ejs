<form method="post" action="/login" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
  <input type="hidden" name="next" value="<%= next %>">
  <% if (error) { %><p class="err err-box"><%= error %></p><% } %>
  <div class="field">
    <label for="email">IITR email</label>
    <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required value="<%= email %>">
  </div>
  <div class="field">
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
  </div>
  <button class="btn btn-lg btn-block <%= mailEnabled ? 'btn-ghost' : '' %>" type="submit">Log in</button>
  <p class="muted center"><a href="/forgot">Forgot password?</a></p>
</form>
