<%- include('partials/head') %>
<div class="narrow">
  <h1>Choose a new password</h1>
  <form method="post" action="/reset" class="card form">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <% if (error) { %><p class="err err-box"><%= error %></p><% } %>
    <div class="field">
      <label for="email">IITR email</label>
      <input id="email" name="email" type="email" autocomplete="email" required value="<%= email %>">
    </div>
    <div class="field">
      <label for="code">Code from the email</label>
      <input id="code" name="code" class="code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required>
    </div>
    <div class="field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
    </div>
    <button class="btn btn-lg btn-block" type="submit">Save password</button>
  </form>
</div>
<%- include('partials/foot') %>
